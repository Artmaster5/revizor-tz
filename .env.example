# Ревизор ТЗ — пример настроек. Скопируйте в .env и впишите свои значения.
# Файл .env не попадает в git. Здесь только заглушки — настоящих ключей в этом файле быть не должно.
# Переменные окружения, заданные в терминале, важнее значений из .env.

# --- Какую модель использовать ---------------------------------------------------------------------
# auto (по найденному ключу) | gemini | anthropic | openai | ollama | offline (только правила, без модели)
LLM_PROVIDER=auto

# --- Google Gemini — бесплатный вариант, рекомендован для хакатона ------------------------------
# Ключ бесплатно: https://aistudio.google.com → Get API key. Подходит ключ любого вида.
GEMINI_API_KEY=your-gemini-key-here
# Основная модель. Название из примера организаторов, gemini-1.5-flash, Google снял с обслуживания;
# если указать его, агент сам подберёт действующую модель и напишет об этом в отчёте.
GEMINI_MODEL=gemini-flash-latest
# Резервная модель: на неё агент переходит, если основная перегружена (503) или её дневная квота
# бесплатного уровня кончилась (429), и повторяет на ней тот же запрос. Пусто — без резервной модели.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Сколько секунд за весь запуск агент готов ждать, пока перегруженная модель освободится (0 — не ждать).
# Когда время кончилось, каждый шаг делает по одной попытке на модель, а при отказе выполняется правилами.
GEMINI_OVERLOAD_WAIT_S=300

# --- Anthropic (Claude) ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-key-here
# Пусто — модель по умолчанию (claude-haiku-5-5: центы за прогон). Самый полный отчёт: claude-opus-5-5 (дороже).
ANTHROPIC_MODEL=
# Глубина рассуждений: low | medium | high | xhigh | max (выше — дороже, рассуждения оплачиваются как выход).
# Пусто — по этапам: противоречия между разделами — high; остальные проверки набора, перепроверка и разбор
# ответов — medium; проверка требований, нарезка, вопросы, черновики тестов, ответы на чек-лист — low.
# Значение — одно усилие для всех этапов.
ANTHROPIC_EFFORT=
# Усилие для отдельных этапов поверх значений по умолчанию (не действует при заданном ANTHROPIC_EFFORT),
# например review=low,set=high. Этапы: slice, review, set (или set_consistency, set_completeness,
# set_standards, set_gaps — проход-критик), skeptic, questions, answers, tests, checklist.
ANTHROPIC_EFFORT_STAGES=

# --- OpenAI или совместимый сервер -----------------------------------------------------------------
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
# Только для совместимых серверов (например, локального прокси); для OpenAI оставьте пустым.
OPENAI_BASE_URL=

# --- Ollama (локальная модель, без ключа) ------------------------------------------------------------
# Чтобы включить локальную модель, впишите адрес сервера (обычно http://localhost:11434) и имя модели.
# Пока адрес пуст, Ollama не выбирается: без ключей агент работает только правилами.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# --- Работа с моделью ----------------------------------------------------------------------------------
# Сколько запросов отправлять одновременно (1–32). Пусто — 1 для Gemini и Ollama, 4 для Claude и OpenAI.
LLM_CONCURRENCY=
# Сколько секунд ждать ответа на один запрос.
LLM_TIMEOUT=600
# Сколько требований проверять в одном запросе (1–200). Пусто — 40 у Gemini (меньше запросов, бережёт
# бесплатную квоту), 12 у остальных.
LLM_BATCH_SIZE=
# Потолок длины ответа модели в токенах; рассуждения модели считаются внутри него.
# Пусто — значения агента: 16 000 на этап, но не меньше 32 000 у Claude и Gemini; проверки набора
# (противоречия, полнота, стандарты) сразу получают 64 000. Обрезанный ответ повторяется один раз: с усилием
# на ступень ниже, а если ниже некуда или усилие не применяется — с большим потолком (до 64 000).
# Число ЗАМЕНЯЕТ значения всех этапов и отключает повтор с большим потолком: ставьте не меньше 64000.
LLM_MAX_TOKENS=

# --- Ограничения Ревизора ------------------------------------------------------------------------------
# Потолок стоимости одного прогона в долларах: после него модель не вызывается, остальное делают правила.
# Пусто — без ограничения. То же, что --max-cost.
REVIZOR_MAX_COST_USD=
# 1 — не читать файлы .env вообще (для тестов и проверок без сети).
REVIZOR_NO_DOTENV=0
