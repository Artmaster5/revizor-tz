# Ревизор ТЗ — пример настроек. Скопируйте в .env и впишите свои значения.
# Файл .env не попадает в git. Здесь только заглушки — настоящих ключей в этом файле быть не должно.
# Переменные окружения, заданные в терминале, важнее значений из .env.

# --- Какую модель использовать -------------------------------------------------------------
# auto (по найденному ключу) | anthropic | gemini | openai | ollama | offline (только правила, без модели)
LLM_PROVIDER=auto

# --- Anthropic (Claude) ----------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-key-here
# Пусто — модель по умолчанию (claude-haiku-5-5: центы за прогон). Самый полный отчёт: claude-opus-5-5 (заметно дороже).
ANTHROPIC_MODEL=
# Глубина рассуждений модели: low | medium | high | xhigh | max. Рассуждения оплачиваются как выход, выше — дороже.
# Пусто — усилие по этапам: поиск противоречий между разделами — high; остальные проверки набора, перепроверка
# и разбор ответов — medium; проверка требований, нарезка, вопросы, черновики тестов и ответы на чек-лист
# из документа — low.
# Значение — одно и то же усилие для всех этапов.
ANTHROPIC_EFFORT=
# Усилие для отдельных этапов поверх значений по умолчанию (не действует, если задан ANTHROPIC_EFFORT):
# например review=low,set=high. Названия этапов: slice, review, set, skeptic, questions, answers, tests, checklist.
ANTHROPIC_EFFORT_STAGES=

# --- Google Gemini -------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-flash-latest

# --- OpenAI или совместимый сервер ------------------------------------------------------------
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
# Только для совместимых серверов (например, локального прокси); для OpenAI оставьте пустым.
OPENAI_BASE_URL=

# --- Ollama (локальная модель, без ключа) ---------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Работа с моделью ------------------------------------------------------------------------------
# Сколько запросов отправлять одновременно (1–32).
LLM_CONCURRENCY=4
# Сколько секунд ждать ответа на один запрос.
LLM_TIMEOUT=600
# Потолок длины ответа модели в токенах. Рассуждения модели считаются внутри этого потолка.
# Пусто — значения агента: 16 000 на этап, но не меньше 32 000 у Claude; проверки набора (противоречия,
# полнота, стандарты) с первой попытки получают 64 000 у Claude и Gemini. Обрезанный ответ повторяется один
# раз с усилием на ступень ниже (xhigh/max → high → medium → low) и тем же потолком; если усилие уже low или
# не применяется — с удвоенным потолком (до 64 000). Повтор стоит ещё одного вызова.
# Если задать число, оно ЗАМЕНЯЕТ значения всех этапов без исключения и повтор с большим потолком отключается:
# ставьте не меньше 64000, иначе проверка набора может обрезаться.
LLM_MAX_TOKENS=

# --- Ограничения Ревизора --------------------------------------------------------------------------
# Потолок стоимости одного прогона в долларах: после него модель больше не вызывается,
# оставшиеся этапы выполняются правилами. Пусто — без ограничения. То же, что --max-cost.
REVIZOR_MAX_COST_USD=
# 1 — не читать файлы .env вообще (для тестов и проверок без сети).
REVIZOR_NO_DOTENV=0
